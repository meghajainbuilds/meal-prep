# Supabase (set after creating the project at supabase.com)
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=
# Personal access token from supabase.com/dashboard/account/tokens, used for CLI/API automation
SUPABASE_ACCESS_TOKEN=
# Server-side only; never commit
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (set after creating a key at console.anthropic.com)
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5-5

# Netlify (personal access token for deploys and site env management)
NETLIFY_AUTH_TOKEN=

# OpenAI (for image generation via gpt-image-1; create at platform.openai.com/api-keys)
OPENAI_API_KEY=
# Optional: override defaults
# IMAGE_MODEL=gpt-image-1
# IMAGE_QUALITY=medium
# IMAGE_SIZE=1024x1024
